# Verdict MCP Server — environment variables
# Copy to .env and fill in your values

# Supabase (same credentials as Triage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MCP Server port
MCP_PORT=3002

# KoshurLock-Holmes (Tier 2, optional)
# Set to the KoshurLock backend URL if running, otherwise leave default
KOSHURLOCK_URL=http://localhost:8080
